# MuxCore release train pin (T-M2-04, FR-INS-006; TDD §5 "Release train").
# One MUXCORE_IMAGE_TAG per umbrella release: installer, operator, starter,
# Helm, kustomize and compose all read the same pin. Sourceable bash; verified
# by scripts/check-pins.sh (also run in umbrella CI).

# Train identifier (year.month.sequence).
MUXCORE_TRAIN=train-2026.10.2

# core release (muxcored binary + image).
CORE_TAG=v0.6.13

# Tag of every module image in compose/Helm/kustomize for this train.
MUXCORE_IMAGE_TAG=v0.6.13

# Official spool catalog version (spool/catalog.json .version).
SPOOL_CATALOG_VERSION=2.6.0
