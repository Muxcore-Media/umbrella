<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MuxCore.Base" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/mux_bg_base</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>

    <style name="Theme.MuxCore" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mux_bg_base</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.MuxCore.Base</item>
    </style>
</resources>
